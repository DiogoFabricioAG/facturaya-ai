APP_NAME="FacturaYa AI"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://facturas.example.com
APP_DOMAIN=facturas.example.com
TLS_EMAIL=admin@example.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="facturas@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AI_DOCUMENT_DRIVER=openai
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=120
OPENAI_CA_BUNDLE=

SUNAT_DEFAULT_DRIVER=fake
SUNAT_DEFAULT_ENVIRONMENT=beta

# Token privado de ApiPeruDev; se configura solo en el VPS.
RUC_LOOKUP_API_PERU_URL=https://api.apiperu.dev/ruc
RUC_LOOKUP_API_PERU_TOKEN=
RUC_LOOKUP_OPENRUC_URL=https://openruc.com/api/ruc
RUC_LOOKUP_CONNECT_TIMEOUT=3
RUC_LOOKUP_TIMEOUT=6
RUC_LOOKUP_CACHE_TTL=86400

# APP_KEY, DB_PASSWORD, PLATFORM_ADMIN_TOKEN y OPENAI_API_KEY se leen
# exclusivamente desde archivos montados en /run/secrets por Docker Compose.
